# App Registration de Entra ID (Azure Portal) — solo para el ingreso del
# PERSONAL JDH (asesores y administradores). Los clientes NO están en el
# tenant: entran por email + contraseña. Ver .claude/ARCHITECTURE.md.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# Secreto de Better Auth (firma/cifra sesiones). Generar con:
#   pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Solo necesario si la URL pública difiere de localhost en dev o en producción.
BETTER_AUTH_URL=

# Postgres donde Better Auth crea sus tablas (user/session/account/verification).
# Aplicar el esquema con `pnpm auth:migrate`.
DATABASE_URL=

# Backend del catálogo (productos, precios, pedidos). Incluye el prefijo real
# de sus rutas. Ver src/lib/api/backend-fetch.ts.
BACKEND_API_URL=

# API PÚBLICO del catálogo (jdh-catalogo-api, NestJS) — endpoints sin sesión
# (productos y proveedores). NEXT_PUBLIC_*: visible en el navegador.
# Ver src/modules/catalogo/api/client.ts.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# "1" sirve productos/proveedores desde el mock local del módulo catalogo
# (sin backend corriendo). Cualquier otro valor (o vacío) usa el API real.
NEXT_PUBLIC_CATALOGO_MOCK=1
