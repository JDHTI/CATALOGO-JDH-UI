# App Registration de Entra ID (Azure Portal) — solo para el ingreso del
# PERSONAL JDH (asesores y administradores). Los clientes NO están en el
# tenant: entran por email + contraseña. Ver .claude/ARCHITECTURE.md.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# Secreto de Better Auth (firma/cifra sesiones). Generar con:
#   pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Solo necesario si la URL pública difiere de localhost en dev o en producción.
BETTER_AUTH_URL=

# Postgres donde Better Auth crea sus tablas (user, session, account,
# verification y rateLimit). Aplicar el esquema con `pnpm auth:migrate`.
#
# Es el MISMO contenedor que levanta el compose de jdh-catalogo-api
# (`jdh-catalogo-postgres`, puerto 5435), pero una BASE distinta: `jdh_auth`,
# no `jdh_catalogo`. Separadas a propósito — un `prisma migrate reset` en el
# API borra su base entera y no puede llevarse por delante las sesiones ni las
# contraseñas de los clientes.
#
# La base la crea sola el script de arranque del API
# (`docker/postgres/init/01-crear-base-auth.sh`) en un entorno nuevo. En uno
# que ya existía, una vez a mano:
#   docker exec jdh-catalogo-postgres \
#     psql -U jdh_catalogo -d postgres -c 'CREATE DATABASE jdh_auth OWNER jdh_catalogo'
#
# Usuario y clave son los de `docker/env/postgres.env` en el repo del API.
DATABASE_URL=postgres://jdh_catalogo:<clave>@localhost:5435/jdh_auth

# Backend del catálogo (productos, precios, pedidos). Incluye el prefijo real
# de sus rutas. Ver src/lib/api/backend-fetch.ts.
BACKEND_API_URL=

# API PÚBLICO del catálogo (jdh-catalogo-api, NestJS) — endpoints sin sesión
# (productos, proveedores y marcas). NEXT_PUBLIC_*: visible en el navegador.
# Es la ÚNICA fuente de productos de la UI: no hay datos de relleno, así que
# sin este servicio arriba el catálogo muestra su estado de error.
# Ver src/modules/catalogo/api/client.ts.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Base pública del bucket (Cloudflare R2) para imágenes generales del sitio
# (hero, banners) que NO vienen del API — se arman a mano como
# `${NEXT_PUBLIC_ASSETS_CDN_URL}/site/<categoria>/<slug>.webp`. Mismo valor
# que S3_PUBLIC_URL en jdh-catalogo-api. Productos y logos no la necesitan:
# esos llegan con URL completa en la respuesta del API.
#
# El dominio público de R2 (`https://pub-<hash>.r2.dev`) sirve la RAÍZ del
# bucket, sin su nombre en la ruta. Con un Custom Domain delante sería
# `https://cdn.jdh.com.co`; con el MinIO del compose del API,
# `http://localhost:9000/jdh-catalogo`.
#
# Sin ella la portada usa sus respaldos (el hero cae a la foto del repo, los
# banners no se dibujan): no hay valor por defecto en el código, para que un
# entorno a medio configurar no apunte en silencio a un bucket equivocado.
# El host permitido en `images.remotePatterns` (next.config.ts) se DERIVA de
# esta misma variable, así que mover el bucket no obliga a tocar dos archivos.
# Ver src/lib/site-assets.ts, src/modules/inicio/placements.ts y
# docs/site-images.md en el repo del API.
NEXT_PUBLIC_ASSETS_CDN_URL=

# Solo para probar un BUILD DE PRODUCCIÓN en local contra el MinIO de
# desarrollo (localhost:9000). Next 16 bloquea por defecto la optimización de
# imágenes servidas desde hosts locales; con "1" se permite. En `next dev` no
# hace falta, y en el despliegue real NUNCA debe activarse.
# Ver next.config.ts.
ALLOW_LOCAL_IMAGE_HOSTS=
