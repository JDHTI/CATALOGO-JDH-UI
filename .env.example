# =============================================================================
# ENTRA ID — ingreso del PERSONAL JDH (asesores y administradores)
#
# App Registration de Azure Portal. Los clientes NO están en el tenant: entran
# por email + contraseña. Ver .claude/ARCHITECTURE.md.
#
# Las tres son OBLIGATORIAS en todos los entornos: `src/lib/auth/server.ts` y
# `src/lib/auth/tenant.ts` las exigen al importar el módulo, así que sin ellas
# ni `next build` ni `next dev` arrancan.
# =============================================================================
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# =============================================================================
# BETTER AUTH
# =============================================================================

# Secreto que firma y cifra las sesiones. OBLIGATORIO. Generar con:
#   pnpm dlx @better-auth/cli secret
# Uno distinto por entorno.
#
# CUIDADO AL ROTARLO: además de invalidar todas las sesiones vivas, con él se
# CIFRA la clave privada de la tabla `jwks` (la que firma los tokens para el
# API). Un secreto nuevo no la puede descifrar y la firma deja de funcionar con
# "Failed to decrypt private key" — no se regenera sola. Rotar el secreto
# obliga a vaciar esa tabla en la misma maniobra:
#   TRUNCATE TABLE jwks;
# El API no necesita nada: `jose` ve un `kid` desconocido y vuelve a pedir el
# JWKS. Solo fallan las peticiones en vuelo con el token viejo (≤5 min).
#
# La clave de firma NO caduca por su cuenta (no se configuró `rotationInterval`
# en el plugin `jwt`), así que rotarla es este mismo TRUNCATE, a propósito.
BETTER_AUTH_SECRET=

# Origen público de la app, con el que Better Auth arma el Redirect URI de
# OAuth (`{BETTER_AUTH_URL}/api/auth/callback/microsoft`) y valida los
# `callbackURL`. OPCIONAL: `resolveBaseURL()` en `src/lib/auth/server.ts` lo
# deriva cuando falta.
#
#   - Local: dejarla VACÍA. Better Auth lo saca del request entrante, así que
#     `next dev` funciona en cualquier puerto sin tocar este archivo.
#   - Preview (Vercel): dejarla VACÍA. Cada despliegue tiene un host propio y
#     un valor fijo aquí rompería el ingreso en todos ellos; se deriva de
#     `VERCEL_URL`.
#   - Producción: FIJARLA al dominio real y completo, con esquema y sin barra
#     final (`https://catalogo.jdh.com.co`). Tiene que ser byte a byte el mismo
#     host del Redirect URI registrado en Entra, o Microsoft responde
#     `AADSTS50011`.
BETTER_AUTH_URL=

# -----------------------------------------------------------------------------
# Postgres de la AUTENTICACIÓN. OBLIGATORIO, y no hay forma de quitarlo.
#
# Por qué una base de datos en las variables de un "frontend": esta app no es
# solo el frontend, es TAMBIÉN el servidor de autenticación. Better Auth corre
# DENTRO del servidor de Next (`src/app/api/auth/[...all]/route.ts` es su
# servidor HTTP, y `src/lib/auth/server.ts` abre un `pg.Pool` propio), así que
# la autenticación y la UI son el mismo despliegue. Es su base, no la de otro
# servicio: guarda los usuarios, las sesiones, los hashes de contraseña de las
# cuentas de cliente y el par de claves de firma. Cualquier sistema de
# autenticación necesita ese almacén; la pregunta útil no es si existe, sino
# quién lo toca.
#
# Y la respuesta es: SOLO esta app. La cadena nunca cruza al navegador (el
# módulo lleva `import "server-only"` y la variable no tiene prefijo
# `NEXT_PUBLIC_`, así que no entra en ningún bundle de cliente), y desde
# 2026-09-07 tampoco la necesita jdh-catalogo-api: identifica al usuario
# verificando un JWT contra `GET /api/auth/jwks`. **No pongas esta variable en
# el entorno del API.** Ver .claude/ARCHITECTURE.md (2026-09-07) y
# docs/despliegue.md §9.
#
# La única forma real de que esta variable desaparezca es mover la identidad a
# un proveedor administrado (Entra External ID para las cuentas de cliente).
# Está anotado como alternativa viva, no descartada.
#
# Tablas que crea `pnpm auth:migrate`: `user`, `session`, `account`,
# `verification`, `rateLimit` y `jwks` (el par de claves con el que se firman
# los tokens del API; la privada cifrada con `BETTER_AUTH_SECRET`). Ejecutarlo
# desde una máquina que alcance esta base — no corre en el build de Vercel.
#
# LOCAL: mismo contenedor que levanta el compose de jdh-catalogo-api
# (`jdh-catalogo-postgres`, puerto 5435), pero una BASE distinta: `jdh_auth`,
# no `jdh_catalogo`. Separadas a propósito — un `prisma migrate reset` en el
# API borra su base entera y no puede llevarse por delante las sesiones ni las
# contraseñas de los clientes. La crea sola el script de arranque del API
# (`docker/postgres/init/01-crear-base-auth.sh`) en un entorno nuevo; en uno
# que ya existía, una vez a mano:
#   docker exec jdh-catalogo-postgres \
#     psql -U jdh_catalogo -d postgres -c 'CREATE DATABASE jdh_auth OWNER jdh_catalogo'
# Usuario y clave son los de `docker/env/postgres.env` en el repo del API.
#
# EN VERCEL: tiene que ser un Postgres accesible desde internet y por el
# PUERTO DEL POOLER en modo transacción (PgBouncer, endpoint `-pooler` de Neon,
# pooler de Supabase), con `sslmode=require`. Cada instancia de función abre su
# propio pool; conectar al puerto directo agota `max_connections` con poco
# tráfico. Ver la nota de `max: 3` en `src/lib/auth/server.ts`.
#   postgres://usuario:clave@host-pooler.region.proveedor.com/jdh_auth?sslmode=require
#
# SI LA BASE ESTÁ EN RAILWAY, ojo con cuál de sus dos variables copias:
#   DATABASE_URL        -> postgres.railway.internal  (red PRIVADA: solo resuelve
#                          ENTRE servicios de Railway; desde Vercel da ENOTFOUND)
#   DATABASE_PUBLIC_URL -> <...>.proxy.rlwy.net:<puerto>   <- ESTA es la buena
# Cópiala tal cual, SIN añadirle `sslmode=require`: el proxy público de Railway
# ya trae el puerto correcto y su Postgres no siempre acepta TLS forzado.
#
# UNA BASE POR ENTORNO, no la misma en preview y producción. Además de mezclar
# sesiones y cuentas, la tabla `jwks` sería compartida: un token firmado en
# preview validaría contra producción.
#
# SÍNTOMA de tener mal esta variable: el sitio carga, pero CUALQUIER ingreso
# responde 500 con el cuerpo vacío — también el de correo y contraseña, que no
# toca Microsoft. En los logs sale "Failed to create verification": Better Auth
# escribe el `state` de OAuth en la base ANTES de redirigir. Si en cambio solo
# falla el ingreso con Entra y el de correo funciona, entonces sí es Entra:
# mira el código AADSTS que devuelve Microsoft.
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://jdh_catalogo:<clave>@localhost:5435/jdh_auth

# =============================================================================
# BACKEND DEL CATÁLOGO (jdh-catalogo-api, NestJS)
# =============================================================================

# API PÚBLICO — endpoints sin sesión (productos, proveedores y marcas).
# OBLIGATORIO. Es la ÚNICA fuente de productos de la UI: no hay datos de
# relleno, así que sin este servicio arriba el catálogo muestra su estado de
# error. Ver src/modules/catalogo/api/client.ts.
#
# `NEXT_PUBLIC_*`: se INCRUSTA en el bundle del navegador en tiempo de BUILD.
# En Vercel eso tiene dos consecuencias: hay que definirla antes de construir
# (cambiarla después exige redespliegue, no basta reiniciar), y en producción
# debe ser HTTPS — una página servida por HTTPS no puede llamar a un `http://`
# ni a `localhost`, el navegador lo bloquea por contenido mixto.
#
# El valor SIEMPRE termina en el prefijo de rutas del API (`/api/v1`), que sale
# de `API_PREFIX` + `API_VERSION` en el entorno del propio API. La raíz del
# host responde 404: no es un error de despliegue.
#
# Despliegue actual (Railway):
#   https://catalogo-jdh-api-production.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# API AUTENTICADO — llamadas servidor a servidor como el usuario de la sesión.
# OPCIONAL hoy: `src/lib/api/backend-fetch.ts` existe pero todavía no lo llama
# nadie, así que no hace falta definirla para desplegar. Incluye el prefijo
# real de las rutas. Pasa a obligatoria en cuanto exista el primer endpoint
# privado (pedidos, listas).
#
# `backend-fetch.ts` reenvía un JWT de 5 minutos firmado por esta app, no el
# token de sesión: el API verifica la firma contra `GET /api/auth/jwks` y NO
# recibe `DATABASE_URL` ni acceso a `jdh_auth`. Lo único que hay que
# configurar del otro lado es `AUTH_JWKS_URL` (variable DEL API, apuntando al
# origen de la UI del mismo entorno). Contrato completo en docs/despliegue.md §9.
BACKEND_API_URL=

# =============================================================================
# IMÁGENES
# =============================================================================

# Base pública del bucket (Cloudflare R2) para imágenes generales del sitio
# (hero, banners) que NO vienen del API — se arman a mano como
# `${NEXT_PUBLIC_ASSETS_CDN_URL}/site/<categoria>/<slug>.webp`. Mismo valor
# que S3_PUBLIC_URL en jdh-catalogo-api. Productos y logos no la necesitan:
# esos llegan con URL completa en la respuesta del API.
#
# El dominio público de R2 (`https://pub-<hash>.r2.dev`) sirve la RAÍZ del
# bucket, sin su nombre en la ruta. Con un Custom Domain delante sería
# `https://cdn.jdh.com.co`; con el MinIO del compose del API,
# `http://localhost:9000/jdh-catalogo`.
#
# Sin ella la portada usa sus respaldos (el hero cae a la foto del repo, los
# banners no se dibujan): no hay valor por defecto en el código, para que un
# entorno a medio configurar no apunte en silencio a un bucket equivocado.
# El host permitido en `images.remotePatterns` (next.config.ts) se DERIVA de
# esta misma variable, así que mover el bucket no obliga a tocar dos archivos
# — pero al ser `NEXT_PUBLIC_*` y alimentar la config, cambiarla en Vercel
# exige redespliegue.
# Ver src/lib/site-assets.ts, src/modules/inicio/placements.ts y
# docs/site-images.md en el repo del API.
NEXT_PUBLIC_ASSETS_CDN_URL=

# Solo para probar un BUILD DE PRODUCCIÓN en local contra el MinIO de
# desarrollo (localhost:9000). Next 16 bloquea por defecto la optimización de
# imágenes servidas desde hosts locales; con "1" se permite. En `next dev` no
# hace falta, y en el despliegue real NUNCA debe activarse.
# Ver next.config.ts.
ALLOW_LOCAL_IMAGE_HOSTS=

# Base pública del bucket (Cloudflare R2) para imágenes generales del sitio
# (hero, banners) que NO vienen del API — se arman a mano como
# `${NEXT_PUBLIC_ASSETS_CDN_URL}/site/<categoria>/<slug>.webp`. Mismo valor
# que S3_PUBLIC_URL en jdh-catalogo-api. Productos y logos no la necesitan:
# esos llegan con URL completa en la respuesta del API.
NEXT_PUBLIC_ASSETS_CDN_URL=
